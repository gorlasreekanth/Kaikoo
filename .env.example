# docker-compose root env — copy to .env and fill in values
# The backend/.env is still required for app secrets (API keys, etc.)

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=kaikoo

# Frontend build args (passed to Vite at image build time)
VITE_API_BASE_URL=http://localhost/api/v1
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id
VITE_DEV_BYPASS_AUTH=false
