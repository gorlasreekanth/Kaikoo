# App
SECRET_KEY=generate-64-char-hex-string-here
FERNET_KEY=generate-via-Fernet.generate_key()
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173

# Database (local dev — used when regional Supabase config is not set)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kaikoo

# Regional databases (Supabase) — passwords go in .secrets, not here
SUPABASE_PROJECT_REF_APAC=your-apac-project-ref
SUPABASE_POOLER_HOST_APAC=aws-1-ap-south-1.pooler.supabase.com
SUPABASE_PROJECT_REF_NOAM=your-noam-project-ref
SUPABASE_POOLER_HOST_NOAM=aws-1-us-west-2.pooler.supabase.com
SUPABASE_DB_PORT=6543
DEFAULT_REGION=noam

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI_CALENDAR=http://localhost:8000/api/v1/calendar/callback
GOOGLE_REDIRECT_URI_GMAIL=http://localhost:8000/api/v1/gmail/callback

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Notion
NOTION_CLIENT_ID=your_notion_client_id
NOTION_CLIENT_SECRET=your_notion_client_secret
NOTION_REDIRECT_URI=http://localhost:8000/api/v1/notion/callback

# JWT
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
