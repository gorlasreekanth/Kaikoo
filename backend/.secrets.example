# Database passwords
# Find in: Supabase Dashboard → Settings → Database → Connection string
SUPABASE_DB_PASSWORD_APAC=your-apac-db-password
SUPABASE_DB_PASSWORD_NOAM=your-noam-db-password

# App secrets
# Generate SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"
# Generate FERNET_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=generate-64-char-hex-string
FERNET_KEY=generate-via-Fernet.generate_key()

# API keys — OpenRouter is the app-level default LLM provider
# Users can bring their own Anthropic/OpenAI keys via settings
OPENROUTER_API_KEY=sk-or-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
NOTION_CLIENT_ID=your-notion-client-id
NOTION_CLIENT_SECRET=your-notion-client-secret
